{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "permissions": {
    "deny": [
      "Read(/**/.env)",
      "Read(./.env.*)",
      "Read(!.env.example)",
      "Read(/**/credentials/**)",
      "Read(/**/*.tfstate)",
      "Read(/**/*.tfstate.*)",
      "Read(/**/*.tfplan)",
      "Read(/**/tfplan)",
      "Read(/**/kubeconfig)",
      "Read(/**/kubeconfig.y*ml)",
      "Read(/**/*.kubeconfig)",
      "Read(/**/profiles.yml)",
      "Read(~/.kube/**)",
      "Read(~/.dbt/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.azure/**)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}
